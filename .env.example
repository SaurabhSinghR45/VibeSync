# Spotify API Credentials (Get from https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# App Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=super-secret-vibe-key-change-in-production

# API & Vector Store Paths
VECTOR_INDEX_PATH=models/vibe_index.faiss
TRACK_METADATA_PATH=data/processed/cleaned_songs.parquet
DATABASE_URL=sqlite:///data/vibesync.db

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
